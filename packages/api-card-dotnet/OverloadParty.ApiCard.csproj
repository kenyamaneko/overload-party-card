<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>OverloadParty.ApiCard</PackageId>
    <Version>0.0.0</Version>
    <Description>Overload Party の card サービスの REST 契約 (.NET のクライアントと DTO)。data/openapi.yaml から NSwag で生成する。battle がマスターデータの JSON (カード定義・施策定義) を読み込む型として使う。</Description>
    <RepositoryUrl>https://github.com/kenyamaneko/overload-party-card</RepositoryUrl>
  </PropertyGroup>
</Project>
